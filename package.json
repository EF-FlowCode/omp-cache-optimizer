{
  "name": "omp-cache-optimizer",
  "version": "2.0.0",
  "description": "Improve OMP prompt/KV cache hit rates with safer prompt churn cleanup, OpenAI-compatible cache keys, proxy compat warnings, and footer cache stats.",
  "keywords": [
    "omp-package",
    "omp",
    "oh-my-pi",
    "deepseek",
    "openai",
    "claude",
    "gemini",
    "cache",
    "kv-cache",
    "prompt-cache",
    "optimizer"
  ],
  "author": "n1netynine99",
  "license": "MIT",
  "files": [
    "index.ts",
    "src"
  ],
  "omp": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://img.shields.io/badge/OMP-Cache%20Optimizer-4A90D9"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "imports": {
    "#extension": "./index.ts"
  },
  "scripts": {
    "test": "node --import jiti/register --test tests/*.test.ts",
    "typecheck": "tsc --noEmit --pretty false",
    "check:diff": "git diff --check",
    "check:pack": "node scripts/check-pack.mjs",
    "check": "npm run typecheck && npm test && npm run check:diff && npm run check:modules && npm run check:pack",
    "check:modules": "node scripts/check-module-graph.mjs"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "18.13.3",
    "@types/node": "^22.0.0",
    "jiti": "^2.7.0",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EF-FlowCode/omp-cache-optimizer.git"
  },
  "homepage": "https://github.com/EF-FlowCode/omp-cache-optimizer",
  "bugs": {
    "url": "https://github.com/EF-FlowCode/omp-cache-optimizer/issues"
  }
}
